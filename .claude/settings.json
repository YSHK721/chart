{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/block_destructive_git.py\"",
            "timeout": 10,
            "statusMessage": "禁止 git コマンドの検査"
          }
        ]
      }
    ]
  }
}
