# ============================================================
# 環境設定ファイル
# ============================================================
.env
*.env
.env.*
.env.local
.env.*.local

# ============================================================
# Python ランタイム
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ============================================================
# 仮想環境
# ============================================================
# 末尾スラッシュを付けない。付けるとディレクトリにしか一致せず、ワークツリー用に張った
#   symlink（実体は別ツリー）が追跡対象に残る。2026-08-10 のマージで `.venv -> 自分自身`
#   が commit され、checkout で venv の実体参照が失われた（同種の事故を再発させないため）。
.venv
venv/
env/
ENV/
.python-version

# ============================================================
# パッケージ・ビルド成果物
# ============================================================
dist/
build/
*.egg-info/
*.egg
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
lib/
lib64/
design/

# ============================================================
# テスト・カバレッジ
# ============================================================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
*.coveragerc
nosetests.xml
test-results/
.tox/
.nox/

# ============================================================
# 静的解析・型チェック
# ============================================================
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/

# ============================================================
# Jupyter Notebook
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# ============================================================
# ドキュメント生成
# ============================================================
docs/_build/
docs/generated/
site/
.pdoc/

# ============================================================
# データファイル（入力・出力）
# ============================================================
input/*
# marketdata 時系列データ（生成物・Sd でパッケージ外へ分離・単一基点 marketdata.paths.DATA_DIR）
#   末尾スラッシュを付けない（理由は上の .venv と同じ: symlink を取りこぼさないため）。
data/marketdata
*.csv
*.tsv
*.json
!.devcontainer/devcontainer.json
!pyproject.toml
# 規約の機械的強制（ISSUE-450・絶対命令 2026-08-28）。禁止 git コマンドを Bash 実行前に遮断する
#   PreToolUse フックの結線。追跡しないと別チェックアウト・worktree で遮断が消え、規約が
#   「文章だけ」へ戻る。個人設定は settings.local.json 側（引き続き無視）。
!.claude/settings.json
# フロント各スライスの manifest / lockfile は追跡する（ISSUE-280）。上の blanket `*.json` は
#   データファイル向けであり、これに巻き込まれると clean clone で `npm ci` が成立しない
#   （実際 unified_ui/web/package.json だけが未追跡のまま lockfile だけ commit されていた）。
#   スイートの起動可否は tools/tests/test_web_suites_ledger.py が検定する。
!**/web/package.json
!**/web/package-lock.json
# テスト golden（byte 一致 oracle・物理 commit する固定 fixture・§10.3 M-2）。生成データの
# blanket *.csv ignore から除外し、移設前コードで採取した golden を版管理に固定する。
!indigators/indicator_ui/api/tests/golden/
!indigators/indicator_ui/api/tests/golden/**
# 銘柄仕様スナップショット（ISSUE-445 段階 2・供給元 MT5 の権威値を機械取得した台帳）。
#   時系列データではなく**版管理する台帳**であり、上の blanket `*.json` から除外する。
#   これに巻き込まれると台帳が clean clone に無く、銘柄仕様の唯一の権威が消える。
#   人が編集する対象ではない（ファイル内 `_generated` が明示・再取得は capture スクリプト）。
!marketdata/symbol_specs/
!marketdata/symbol_specs/**
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.npz
*.sqlite
*.db

# Market Profile dwell 日別ロールアップのディスク永続キャッシュ（生成物・再構築可能）。
# 既定は DATA_DIR(data/marketdata) 配下だが、DATA_DIR を上書きした場合も追跡しないよう明示除外。
cache/market_profile_dwell/
**/cache/market_profile_dwell/

