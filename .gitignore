docker-compose.override.yml
# backtest テスト fixture（MT5突合 golden）は *.json 除外の例外として追跡
!simulator/tests/fixtures/
!simulator/tests/fixtures/**
# ただし fixture 配下でも OS/Python の生成物は追跡しない（!** の再包含を打ち消す）
simulator/tests/fixtures/**/__pycache__/
simulator/tests/fixtures/**/.DS_Store
# 突合検証用の使い捨て生データ・スクリプト（大容量・コミット対象外）
simulator/tests/confirmation/
simulator/tests/260620-01/

# MP analysis 生成物・ブラウザ検証成果物（2026-07-12）
.playwright-mcp/
indigators/market_profile/analysis/out/
.pytest_cache/

# codescan（コード重複走査）の出力先。走査結果は再生成できるためコミットしない。
.codescan/

# worktree ごとのローカル環境設定（tools/setup_worktree.sh が生成・ISSUE-365）。
#   git 管理外の実体（venv・データ）を絶対パスで指す。ツリーごとに内容が異なるため
#   コミットしてはならない（コミットすると他ツリーの実体を指す設定が配られる）。
dev_paths.local.sh
# 口座状態エンジンのシナリオ入力（ISSUE-369）は *.json 除外の例外として追跡
#   （out/ の生成 JSON・HTML は従来どおり追跡しない）
!prototype_260811-01/plans/*.json

# sim core のジョブ台帳（実行時生成物。成果物をリポジトリへ入れない・ISSUE-363 同型の再発防止）
simulator/sim_ui/data/

# MT5 一次情報 corpus（Tester Settings .ini 44 件・UTF-16LE バイナリ）。
#   TESTER_SETTINGS_BASIC_DESIGN.md の一次情報。追跡外（D-06 前提・ISSUE-385 承認 2026-08-17）
sample/
